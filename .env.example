# Nusxa oling: cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=512
LLM_TEMPERATURE=0
LLM_SEED=42
# "Thinking" modellari uchun: false — o'chirish; bo'sh — umuman yuborilmaydi
LLM_THINK=
LLM_KEEP_ALIVE=30m
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_S=120
EMBED_TIMEOUT_S=60
EMBED_BATCH_SIZE=32

# --- Qidiruv va javob ---
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=30
EXPANSION_MAX=3
CONTEXT_TOKEN_BUDGET=3500
# Eng yaxshi natijaning cosine o'xshashligi shundan past bo'lsa, LLM chaqirilmaydi
REFUSAL_THRESHOLD=0.50

# --- Chunking ---
# structural — huquqiy tuzilma bo'yicha; fixed — taqqoslash uchun oddiy oyna
CHUNK_STRATEGY=structural
CHUNK_MAX_CHARS=1500
FIXED_CHUNK_SIZE=1000
FIXED_CHUNK_OVERLAP=200

# --- Manba va indeks ---
SOURCE_URL=https://lex.uz/uz/docs/-8193120
SOURCE_HTML=data/raw/lex_8193120.html
INDEX_DIR=data/index
INDEX_KEEP_VERSIONS=2
AUTO_INGEST=true

LOG_LEVEL=INFO
